{
  "name": "unstressed-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "export": "expo export --platform ios --platform android",
    "check": "npm run typecheck && npm test && expo install --check && npm run export",
    "web": "expo start --web",
    "export:web": "expo export --platform web --output-dir dist-web",
    "start:go": "expo start --go --lan"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.3",
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.23",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-font": "~58.0.11",
    "expo-location": "~58.0.20",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "~6.0.3"
  },
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  }
}
