{
  "name": "unstressed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm ci --prefix backend && npm ci --prefix frontend",
    "lint": "node scripts/check-source.mjs",
    "test": "npm test --prefix backend && npm test --prefix frontend",
    "build": "npm run build --prefix frontend",
