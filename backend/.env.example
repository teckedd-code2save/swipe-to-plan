# Required for real solo discovery (server-side only)
QLOO_API_KEY=

# Optional existing Qloo endpoint; defaults to the hackathon endpoint
QLOO_API_URL=https://hackathon.api.qloo.com

# Optional: existing database for group rooms only
DATABASE_URL=

# Local server
HOST=127.0.0.1
PORT=4000
# Optional conversational planner. Guided planning and discovery do not need a model.
# Gemini Flash-Lite is the default. The legacy Anthropic variables are not read.
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# For another OpenAI-compatible provider, set its base URL, model and LLM_API_KEY.
LLM_API_KEY=

# Optional shared-day persistence file. Default: backend/data/days.json.
# Mount its parent directory on a durable volume when deploying (single server).
# DAY_DATA_FILE=/data/outing/days.json

# Optional Google accounts and persistent circles (server-side credentials only).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APP_ORIGIN=http://127.0.0.1:5173
# Register APP_ORIGIN/api/auth/google/callback with Google. HTTPS in production.
# ACCOUNT_DATA_FILE=/data/unstressed/accounts.json

# Private owner dashboard; verified Google sign-in email(s), comma-separated.
ADMIN_EMAILS=
# Production: /data/usage.json (local defaults to backend/data/usage.json).
USAGE_DATA_FILE=

# Optional email invitations to circles. Requires a verified sending domain with Resend.
RESEND_API_KEY=
CIRCLE_INVITE_FROM=
