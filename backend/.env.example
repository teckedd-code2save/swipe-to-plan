# Required for real solo discovery (server-side only)
QLOO_API_KEY=

# Optional existing Qloo endpoint; defaults to the hackathon endpoint
QLOO_API_URL=https://hackathon.api.qloo.com

# Optional: existing database for group rooms only
DATABASE_URL=

# Local server
HOST=127.0.0.1
PORT=4000
# No language-model credentials are required or used.
